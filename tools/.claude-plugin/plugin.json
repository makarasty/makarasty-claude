{
  "name": "makarasty-tools",
  "description": "Five small commands that travel with the fleet plugin but are versioned apart from it: commit under your own name, review a diff and report only findings with evidence, strip assistant tics out of writing, say what you mean in simple English a person can read aloud to a vendor, and get one message on your phone when a chat you walked away from finishes.",
  "version": "1.2.0",
  "author": {
    "name": "makarasty",
    "url": "https://github.com/makarasty"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/unslop.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking unslop mode"
          },
          {
            "type": "command",
            "command": "[ -n \"$(ls \"$CLAUDE_CONFIG_DIR/makarasty/notify/\"*.json \"$HOME/.claude/makarasty/notify/\"*.json 2>/dev/null)\" ] && node \"${CLAUDE_PLUGIN_ROOT}/hooks/notify.mjs\" || true",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$(ls \"$CLAUDE_CONFIG_DIR/makarasty/notify/\"*.json \"$HOME/.claude/makarasty/notify/\"*.json 2>/dev/null)\" ] && node \"${CLAUDE_PLUGIN_ROOT}/hooks/notify.mjs\" || true",
            "timeout": 20,
            "async": true
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$(ls \"$CLAUDE_CONFIG_DIR/makarasty/notify/\"*.json \"$HOME/.claude/makarasty/notify/\"*.json 2>/dev/null)\" ] && node \"${CLAUDE_PLUGIN_ROOT}/hooks/notify.mjs\" || true",
            "timeout": 20,
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|agent_needs_input|elicitation_dialog|elicitation_url_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$(ls \"$CLAUDE_CONFIG_DIR/makarasty/notify/\"*.json \"$HOME/.claude/makarasty/notify/\"*.json 2>/dev/null)\" ] && node \"${CLAUDE_PLUGIN_ROOT}/hooks/notify.mjs\" || true",
            "timeout": 20,
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$(ls \"$CLAUDE_CONFIG_DIR/makarasty/notify/\"*.json \"$HOME/.claude/makarasty/notify/\"*.json 2>/dev/null)\" ] && node \"${CLAUDE_PLUGIN_ROOT}/hooks/notify.mjs\" || true",
            "timeout": 20,
            "statusMessage": "Checking for an armed notification"
          }
        ]
      }
    ]
  }
}
