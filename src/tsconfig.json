{
  "compilerOptions": {
    "strict": true,
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "erasableSyntaxOnly": true,
    "types": ["node"],
    "rootDir": ".",
    "outDir": "..",
    "newLine": "lf"
  },
  "include": ["hooks/*.mts", "scripts/*.mts", "scripts/fleet/*.mts"],
  "exclude": ["node_modules"]
}
