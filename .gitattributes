# The shell scripts must arrive with LF endings on every platform: a CRLF shebang makes Git Bash
# look for an interpreter named "/bin/sh" and report "bad interpreter", which reads as a broken
# install rather than a line-ending problem.
*.sh text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
