{
  "name": "makarasty",
  "description": "Run one job across several Claude Code sessions: a shared task queue, reports written to files, a frame-count check before every browser observation, and a gate that refuses a fix without a reproduction that failed first. Ten mission kinds, from test sweeps and fixes to refactors, research and design.",
  "version": "1.5.14",
  "author": {
    "name": "makarasty",
    "url": "https://github.com/makarasty"
  },
  "homepage": "https://github.com/makarasty/makarasty-claude",
  "repository": "https://github.com/makarasty/makarasty-claude",
  "license": "MIT",
  "keywords": [
    "multi-agent",
    "parallel-sessions",
    "testing",
    "browser",
    "worktrees",
    "evidence"
  ],
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/fleet-guard.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking for an unfinished claim"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/fleet-contract.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking the contract surface"
          }
        ]
      },
      {
        "matcher": "^(Bash|PowerShell|Monitor|Agent|Task|Skill)$|^mcp__(.*[Bb]rowser|claude-in-chrome)__",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/fleet-memory.mjs\"",
            "timeout": 6,
            "statusMessage": "Checking what the machine has left"
          }
        ]
      }
    ]
  }
}
